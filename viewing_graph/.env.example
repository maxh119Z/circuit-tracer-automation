# Copy this to `.env` (which is gitignored) and fill in the values.
# Loaded automatically by build_views.py and verify_views.py.
#
# DO NOT put real keys in this file — it is committed. Real keys go in `.env`.

# REQUIRED — generate graphs + save subgraphs on Neuronpedia.
# Create an account at https://neuronpedia.org, then Account -> API Keys.
NEURONPEDIA_API_KEY=

# OPTIONAL — the HF dataset is public, so this is only needed if a pull 401s.
HF_TOKEN=
